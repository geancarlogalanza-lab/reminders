{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reminders",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "vars": { "APP_URL": "https://reminders.gean-minders.workers.dev" },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "reminders", "database_id": "00763daf-6ffd-4dc5-a733-329242893100" }
  ],
  "observability": { "enabled": true }
}
